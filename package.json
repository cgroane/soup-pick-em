{
  "name": "soup-pick-em",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@reduxjs/toolkit": "^1.9.7",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.10",
    "@types/react-redux": "^7.1.27",
    "autoprefixer": "^10.4.27",
    "axios": "^1.5.1",
    "body-parser": "^1.20.2",
    "cfb.js": "^4.3.2",
    "cfbd": "^5.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "express": "^5.1.0",
    "firebase": "^10.5.0",
    "firebase-admin": "^13.6.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.576.0",
    "match-sorter": "^6.3.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.8",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "sort-by": "^1.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "serve": "tsx api/index.ts",
    "serve:emu": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx api/index.ts",
    "start:emu": "REACT_APP_USE_EMULATOR=true react-scripts start",
    "dev": "concurrently -k -n emu,api,web -c magenta,cyan,green \"npm run fb:serve\" \"wait-on tcp:127.0.0.1:8080 && npm run serve:emu\" \"wait-on tcp:127.0.0.1:8080 && npm run start:emu\"",
    "dev:live": "concurrently -k -n api,web -c cyan,green \"npm run serve\" \"npm run start\"",
    "migrate:groups:dry": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=soup-pick-em node scripts/migrate-groups.js --dry-run",
    "migrate:groups": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=soup-pick-em node scripts/migrate-groups.js",
    "verify:groups": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=soup-pick-em node scripts/verify-groups.js",
    "seed:auth:emu": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=soup-pick-em node scripts/seed-emulator-auth.js",
    "prepare": "husky",
    "lint": "eslint --ext .js,.ts . --fix",
    "fb:build": "npm --prefix functions run build",
    "fb:build:watch": "npm --prefix functions run build:watch",
    "fb:serve": "npm --prefix functions run build && firebase emulators:start --import=./emulator-data/dev-seed --only auth,functions,firestore",
    "fb:shell": "npm --prefix functions run build && firebase functions:shell",
    "fb:start": "npm run fb:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/cors": "^2.8.19",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "tsx": "^4.21.0",
    "wait-on": "^9.1.0"
  }
}
